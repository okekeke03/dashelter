// Cloudflare Workers の設定。GitHub に push すると、Workers Builds が `npx wrangler deploy` で公開する。
// name は Cloudflare のダッシュボード上の Worker 名と一致させる必要がある。
{
  "name": "dashelter",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    // web/ を静的ファイルとして配信する。web/_headers のヘッダー(CSP など)も付く
    "directory": "./web",
    "binding": "ASSETS",
    // /api/* は静的ファイルより先に Worker に回す
    "run_worker_first": ["/api/*"]
  },
  // エラーの調査用にログを残す(無料プランの範囲)
  "observability": {
    "enabled": true
  }
}
